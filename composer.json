{
  "name": "mfc/oauth2",
  "description": "Generic OAuth2 authentication and authorization for TYPO3 CMS",
  "license": [
    "GPL-2.0-or-later"
  ],
  "type": "typo3-cms-extension",
  "keywords": [
    "TYPO3 CMS",
    "OAuth"
  ],
  "authors": [
    {
      "name": "Christian Hellmund",
      "role": "Developer"
    },
    {
      "name": "Sebastian Klein",
      "role": "Developer"
    },
    {
      "name": "Simon Schmidt",
      "role": "Developer"
    },
    {
      "name": "Karoline Steinfatt",
      "role": "Maintainer"
    },
    {
      "name": "Christian Spoo",
      "role": "Developer"
    }
  ],
  "homepage": "https://www.marketing-factory.de",
  "require": {
    "php": "^8.2",
    "league/oauth2-client": "^2.6",
    "m4tthumphrey/php-gitlab-api": "^11.13.0",
    "omines/oauth2-gitlab": "^3.4",
    "php-http/guzzle7-adapter": "^1.0",
    "psr/http-factory": "^1.0",
    "typo3/cms-beuser": "^13.4 || ^14.2 || dev-main",
    "typo3/cms-core": "^13.4 || ^14.2 || dev-main"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.51",
    "friendsofphp/php-cs-fixer": "^3.95.1",
    "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
    "ssch/typo3-rector": "^3.6",
    "stevenmaguire/oauth2-keycloak": "^6.1.1",
    "typo3/testing-framework": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Mfc\\OAuth2\\": "Classes/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "php-http/discovery": true,
      "typo3/class-alias-loader": false,
      "typo3/cms-composer-installers": false
    },
    "bin-dir": ".Build/bin",
    "sort-packages": true,
    "vendor-dir": ".Build/vendor"
  },
  "extra": {
    "branch-alias": {
      "dev-latest": "4.x-dev"
    },
    "typo3/cms": {
      "extension-key": "oauth2",
      "web-dir": ".Build/public"
    }
  }
}
